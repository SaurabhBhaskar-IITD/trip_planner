# ---------------------------------------------------------------------------
# Trip Le Planner — environment configuration
# Copy this file to `.env.local` and fill in real values. NEVER commit .env*.
# ---------------------------------------------------------------------------

# Neon PostgreSQL connection string for the dedicated Trip Le Planner database.
# The database/branch is chosen entirely here — point dev/staging/prod at the
# matching Neon branch. Get this from the Neon console (use the pooled connection
# string for the app). Example:
#   postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/trip_le_planner?sslmode=require
DATABASE_URL=

# Auth.js (NextAuth v5) secret used to sign session JWTs & CSRF tokens.
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Public base URL of the planner app. Used for absolute links & auth callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment is set automatically by Next.js (development|production);
# do not set NODE_ENV here.
